# CampusNest local configuration.
# Copy this file to ".env" (same folder) and replace the placeholder values.
# ".env" is git-ignored. Never commit real passwords.
#
# This one file is read by BOTH:
#   - docker compose   (to create the PostgreSQL container)
#   - the Spring Boot backend (via spring.config.import in application.properties)

# --- PostgreSQL ---
POSTGRES_DB=campusnest
POSTGRES_USER=campusnest
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# The browser origin allowed by CORS (the Next.js dev server).
FRONTEND_ORIGIN=http://localhost:3000
# true in production (HTTPS). Keep false for local http://localhost.
SESSION_COOKIE_SECURE=false

# --- First administrator account (created at backend startup if it does not exist) ---
# Use a password of at least 12 characters. Leave empty to skip creating an admin.
ADMIN_EMAIL=admin@campusnest.local
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_DISPLAY_NAME=CampusNest Admin
